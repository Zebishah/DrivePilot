{
  "name": "professional-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"pnpm run dev:frontend\"",
    "dev:frontend": "vite --open",
    "dev:server": "cd ../server && pnpm run dev",
    "build": "tsc && vite build",
    "start": "pnpm run build && pnpm run preview",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "format": "prettier --write .",
    "clean": "rm -rf node_modules dist && pnpm store prune && pnpm install",
    "type-check": "tsc --noEmit --skipLibCheck false --strict"
  },
  "dependencies": {
    "@apollo/client": "^3.13.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@hookform/resolvers": "^4.1.0",
    "@mui/icons-material": "^6.4.1",
    "@mui/material": "^6.4.1",
    "@mui/x-date-pickers": "^7.24.1",
    "@reduxjs/toolkit": "^2.2.1",
    "@types/crypto-js": "^4.2.2",
    "@types/styled-components": "^5.1.34",
    "axios": "^1.6.7",
    "clsx": "^2.1.0",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.4.7",
    "graphql": "^16.10.0",
    "js-cookie": "^3.0.5",
    "jwt-decode": "^4.0.0",
    "dayjs": "^1.11.13",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-circular-progressbar": "^2.2.0",
    "react-cookie": "^7.2.2",
    "react-datepicker": "^7.6.0",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "react-hot-toast": "^2.5.2",
    "react-icons": "^5.4.0",
    "react-leaflet": "^4.2.1",
    "react-redux": "^9.1.0",
    "react-router-dom": "^6.22.3",
    "styled-components": "^6.1.14",
    "swiper": "^11.2.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "concurrently": "^9.1.2",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2"
  }
}
