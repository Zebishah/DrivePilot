# Public Vite variables only. These values are bundled into the browser.

# Render API base URL (used by REST/assistant calls; no trailing /graphql)
VITE_API_URL=https://<render-api-service>.onrender.com

# Apollo GraphQL endpoint
VITE_APP_BACKEND_URL=https://<render-api-service>.onrender.com/graphql

# OAuth, Socket.IO, and auth base URL. Keep the trailing slash for /auth/... links.
VITE_APP_AUTH_URL=https://<render-api-service>.onrender.com/

# Client-side cookie obfuscation key. This is public once bundled and is not a security secret.
VITE_APP_ENCRYPTION_KEY=<stable-client-compatible-key>

# Stripe TEST MODE publishable key only
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_<test-publishable-key>

# Display and business-timezone formatting
VITE_SLOT_TIMEZONE=Europe/Zurich

# VITE_APP_BACKEND_WS_URL is not currently read by application code; Socket.IO uses VITE_APP_AUTH_URL.
