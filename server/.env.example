# Backend environment template for DSP Marketplace.
# Copy this file to server/.env and replace every placeholder with a real value.
# Never commit server/.env or production secrets.

NODE_ENV=development
PORT=4000

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/dsp_marketplace
# Kept for compatibility with existing deployment configuration.
DB_PASSWORD=replace-with-database-password

# Authentication
JWT_SECRET=replace-with-a-long-random-secret

# Frontend callback/origin
FRONTEND_URL=http://localhost:5173
# Legacy spelling still accepted by the backend; prefer FRONTEND_URL.
Frontend_URL=http://localhost:5173

# Stripe
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_CLIENT_ID=ca_replace_me

# OAuth
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
FACEBOOK_APP_ID=replace-with-facebook-app-id
FACEBOOK_APP_SECRET=replace-with-facebook-app-secret

# Email service
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_replace_me
EMAIL_FROM=DSP <onboarding@resend.dev>
EMAIL_NAME=DSP
ADMIN_EMAIL=your-email@example.com

EMAIL_ENABLED=true

# Without custom domain, keep test mode
EMAIL_MODE=test
EMAIL_TEST_RECIPIENT=your-resend-account-email@example.com

# AWS/S3 document storage
AWS_ACCESS_KEY_ID=replace-with-aws-access-key
AWS_SECRET_ACCESS_KEY=replace-with-aws-secret-key
AWS_REGION=eu-central-1
BUCKET_NAME=replace-with-s3-bucket-name

# Scheduling and lesson timing
SLOT_TIMEZONE=Europe/Zurich
CRON_RUNS=false
RUN_API=true
RUN_WORKER=false
T_CHARGE_WINDOW_HOURS=48

# Job execution defaults (all values are milliseconds unless stated otherwise)
JOB_LEASE_MS=600000
JOB_HEARTBEAT_MS=60000
JOB_SHUTDOWN_TIMEOUT_MS=30000
JOB_MAX_RETRY_DELAY_MS=3600000
JOB_BATCH_SIZE=25
PAYOUT_JOB_INTERVAL_MS=180000
PAYOUT_JOB_BATCH_SIZE=25
T48_CHARGE_JOB_INTERVAL_MS=60000
T48_CHARGE_JOB_BATCH_SIZE=25
T48_REMINDER_JOB_INTERVAL_MS=600000
REMINDER_JOB_BATCH_SIZE=25
PENDING_CLEANUP_JOB_INTERVAL_MS=86400000
PENDING_CLEANUP_BATCH_SIZE=25
PENDING_CLEANUP_STALE_MINUTES=1440
ABANDONED_REMINDER_INTERVAL_MS=600000
ABANDONED_REMINDER_AFTER_MINUTES=10
LESSON_END_REMINDER_INTERVAL_MS=120000
LESSON_REMINDER_BATCH_SIZE=5
EMAIL_CLAIM_MS=900000
REDIS_URL=rediss://default:replace-me@host:port
# Optional read-performance cache. MongoDB remains authoritative.
CACHE_ENABLED=true
CACHE_KEY_PREFIX=dsp
CACHE_SCHEMA_VERSION=v1
CACHE_DEFAULT_TTL_SECONDS=300
# Webhook processing and reconciliation
STRIPE_WEBHOOK_PROCESSOR_INTERVAL_MS=5000
STRIPE_WEBHOOK_LEASE_MS=300000
STRIPE_WEBHOOK_MAX_ATTEMPTS=8
STRIPE_WEBHOOK_MAX_BACKOFF_MS=3600000
STRIPE_WEBHOOK_BATCH_SIZE=25
FINANCIAL_RECONCILIATION_INTERVAL_MS=900000
FINANCIAL_RECONCILIATION_BATCH_SIZE=25
