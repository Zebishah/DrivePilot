# DSP Marketplace backend deployment template.
# Never commit server/.env or replace placeholders with real credentials.
# The API uses RUN_API=true/RUN_WORKER=false; the worker uses the inverse.

# App
NODE_ENV=production
PORT=10000

# Database (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster>/<database>?retryWrites=true&w=majority

# Authentication
JWT_SECRET=<random-secret-at-least-32-characters>

# Frontend origin and callback target
FRONTEND_URL=https://<vercel-project>.vercel.app
# Deprecated compatibility spelling accepted by existing code; leave unset.
Frontend_URL=

# Stripe TEST MODE only
STRIPE_SECRET_KEY=sk_test_<test-secret>
STRIPE_WEBHOOK_SECRET=whsec_<test-webhook-signing-secret>
STRIPE_CONNECT_WEBHOOK_ENABLED=true
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_<test-connect-webhook-signing-secret>
# STRIPE_CLIENT_ID is not used by the current Connect implementation.

# Google OAuth (API only)
GOOGLE_CLIENT_ID=<google-client-id>
GOOGLE_CLIENT_SECRET=<google-client-secret>

# Facebook OAuth is supported by existing routes but optional for this deployment.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Email / Resend
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_<resend-api-key>
EMAIL_FROM=DSP Marketplace <onboarding@resend.dev>
EMAIL_NAME=DSP Marketplace
ADMIN_EMAIL=<admin-email>
EMAIL_ENABLED=true
# Use test until a verified sending domain is configured.
EMAIL_MODE=test
EMAIL_TEST_RECIPIENT=<resend-test-recipient>
EMAIL_REQUEST_TIMEOUT_MS=10000

# AWS S3 private document bucket
AWS_ACCESS_KEY_ID=<aws-access-key-id>
AWS_SECRET_ACCESS_KEY=<aws-secret-access-key>
AWS_REGION=<s3-bucket-region>
BUCKET_NAME=<private-s3-bucket-name>

# Lesson timing and process roles
SLOT_TIMEZONE=Europe/Zurich
T_CHARGE_WINDOW_HOURS=48
CRON_RUNS=false
RUN_API=true
RUN_WORKER=false

# Durable worker scheduling (milliseconds unless stated otherwise)
JOB_LEASE_MS=600000
JOB_HEARTBEAT_MS=60000
JOB_SHUTDOWN_TIMEOUT_MS=30000
JOB_MAX_RETRY_DELAY_MS=3600000
JOB_BATCH_SIZE=25
PAYOUT_JOB_INTERVAL_MS=180000
PAYOUT_JOB_BATCH_SIZE=25
T48_CHARGE_JOB_INTERVAL_MS=60000
T48_CHARGE_JOB_BATCH_SIZE=25
T48_REMINDER_JOB_INTERVAL_MS=600000
REMINDER_JOB_BATCH_SIZE=25
PENDING_CLEANUP_JOB_INTERVAL_MS=86400000
PENDING_CLEANUP_BATCH_SIZE=25
PENDING_CLEANUP_STALE_MINUTES=1440
ABANDONED_REMINDER_JOB_INTERVAL_MS=600000
ABANDONED_REMINDER_AFTER_MINUTES=10
LESSON_END_REMINDER_INTERVAL_MS=120000
LESSON_REMINDER_BATCH_SIZE=5
EMAIL_CLAIM_MS=900000
OUTBOX_EMAIL_PROCESSOR_INTERVAL_MS=5000
OUTBOX_EMAIL_LEASE_MS=600000
OUTBOX_EMAIL_BATCH_SIZE=25
OUTBOX_EMAIL_MAX_ATTEMPTS=8
OUTBOX_EMAIL_MAX_BACKOFF_MS=3600000

# Optional Upstash Redis read cache (MongoDB remains authoritative)
REDIS_URL=rediss://default:<redis-password>@<upstash-endpoint>:6379
CACHE_ENABLED=true
CACHE_KEY_PREFIX=dsp
CACHE_SCHEMA_VERSION=v1
CACHE_DEFAULT_TTL_SECONDS=300

# Read-only assistant (API only; set AI_ENABLED=false in worker environment)
AI_ENABLED=true
AI_MODE=live
AI_PROVIDER=gemini
GEMINI_API_KEY=<gemini-api-key>
GEMINI_MODEL=gemini-3.1-flash-lite
AI_RATE_LIMIT_WINDOW_MS=900000
AI_RATE_LIMIT_MAX=30
AI_MAX_TOOL_ROUNDS=4
AI_MAX_TOOLS_PER_REQUEST=6
AI_MAX_TOOL_RESULT_BYTES=32768
AI_MAX_MESSAGE_CHARS=4000
AI_MAX_HISTORY_MESSAGES=8
AI_MAX_HISTORY_CHARS=12000
AI_TOOL_TIMEOUT_MS=2500
AI_REQUEST_TIMEOUT_MS=15000

# Stripe webhook processor and financial reconciliation
STRIPE_WEBHOOK_PROCESSOR_INTERVAL_MS=5000
STRIPE_WEBHOOK_LEASE_MS=300000
STRIPE_WEBHOOK_MAX_ATTEMPTS=8
STRIPE_WEBHOOK_MAX_BACKOFF_MS=3600000
STRIPE_WEBHOOK_BATCH_SIZE=25
FINANCIAL_RECONCILIATION_INTERVAL_MS=900000
FINANCIAL_RECONCILIATION_BATCH_SIZE=25
